# ==================================================
# Cross-Lingual Translation Chain Experiment
# API Configuration
# ==================================================
# Copy this file to .env and fill in your credentials.
# Multiple models supported: use MODEL1_, MODEL2_, etc.

# --- Model 1 ---
MODEL1_NAME=gpt-4o
MODEL1_BASE_URL=https://api.openai.com/v1
MODEL1_API_KEY=your-api-key-here

# --- Model 2 (optional) ---
# MODEL2_NAME=claude-3.5-sonnet
# MODEL2_BASE_URL=https://api.anthropic.com/v1
# MODEL2_API_KEY=your-api-key-here

# --- Default Generation Parameters ---
API_MODE=completion # 'completion' or 'response' (March 2025 Responses API)
TEMPERATURE=0.0
MAX_TOKENS=10000
TIMEOUT=60.0

# --- Batching ---
# Number of source paragraphs to include in a single API request.
# Higher values save tokens (shared batch wrapper) but increase per-request size.
# Example: 4 means each API call handles 4 paragraphs × 4 groups = 16 tasks.
PARAGRAPHS_PER_REQUEST=1

# RESUME_DIR=3_exps/results/gemini-3-flash-preview_20260502_221030 #last break dir
